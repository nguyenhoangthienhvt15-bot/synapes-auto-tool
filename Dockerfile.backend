FROM node:20-alpine

WORKDIR /app

RUN apk add --no-cache ffmpeg yt-dlp python3

COPY package*.json ./
RUN npm ci --omit=dev

COPY . .
RUN npm run build

ENV NODE_ENV=production
EXPOSE 10000

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
  CMD wget -qO- http://127.0.0.1:10000/api/health || exit 1

CMD ["node", "server.js"]
