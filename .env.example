# ==============================================================================
# SYNAPES STUDIO — BIẾN MÔI TRƯỜNG MẪU (.env.example)
# Sao chép thành `.env` trên máy phát triển hoặc khai báo trên Render Dashboard.
# Tạo khóa 256-bit bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ==============================================================================

NODE_ENV=development
PORT=10000
TRUST_PROXY=0

# Bảo mật lõi & Mã hóa BYOK Vault (BẮT BUỘC >= 32 ký tự hex ở Production, Fail-Closed)
MASTER_VAULT_KEY=
JWT_SECRET=
WEBHOOK_SECRET=
SYNAPES_SYNC_SECRET=
SYNAPES_MASTER_KEY=

# Danh sách Origin hợp lệ (phân tách bằng dấu phẩy, không dùng wildcard *.onrender.com)
ALLOWED_ORIGINS=https://synapes-auto-tool-web-service.onrender.com

# Thông tin định danh Bên A hiển thị trên Hợp đồng điện tử (không hardcode trong Git)
VITE_PARTY_A_ID_NUMBER=Theo hồ sơ pháp lý Bên A

# Database & Storage (tùy chọn khi triển khai Docker/DB)
DB_NAME=synapes_studio
DB_USER=synapes_admin
DB_PASSWORD=

# Cấu hình SMTP TLS gửi OTP 6 số Quên mật khẩu & Cảnh báo hệ thống
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Google OAuth 2.0 (YouTube Data API v3 & Google Drive — 1-click Sign-In)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
