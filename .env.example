WEBHOOK_SECRET=[REDACTED_BY_P0_AUDIT]

# Cấu hình SMTP Daemon Gửi Cảnh Báo Khẩn Cấp (nguyenhoangthien.hvt.15@gmail.com)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=nguyenhoangthien.hvt.15@gmail.com
SMTP_PASS=your-gmail-app-password

# Google OAuth 2.0 (YouTube Data API v3 & Google Drive — 1-click Sign-In)
# Tạo tại: https://console.cloud.google.com/apis/credentials (Web Application)
