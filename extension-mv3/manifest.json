{
  "manifest_version": 3,
  "name": "Synapes Auto Video Companion & Hardware Exporter",
  "version": "7.0.0",
  "description": "1-Click YouTube/TikTok DNA Extractor, CORS-free Fact Harvester, Character Cutout Vault, WebCodecs Offscreen 4K Exporter & AES-GCM BYOK Vault.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus",
    "offscreen",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://*.tiktok.com/*",
    "https://commons.wikimedia.org/*",
    "https://en.wikipedia.org/*",
    "https://vi.wikipedia.org/*",
    "https://news.google.com/*",
    "https://synapes-auto-tool-web-service.onrender.com/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Synapes Studio Companion"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/watch*",
        "https://www.youtube.com/shorts/*",
        "https://www.tiktok.com/@*/video/*"
      ],
      "js": ["content-youtube.js"],
      "run_at": "document_idle"
    }
  ]
}
